{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vaidt/Projekt-Aura-BETA-/blob/main/schemas/evidence-record.schema.json",
  "title": "AURA BETA Evidence Record",
  "description": "NON-NORMATIVE draft schema for evidence metadata in the BETA engineering workspace. It does not define the AURA protocol's normative Evidence Pack or cryptographic preimage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "claim_id",
    "source_uri",
    "source_revision",
    "evidence_availability",
    "verification_result",
    "verification_method",
    "scope_coverage",
    "observed_at",
    "reviewer",
    "limitations"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EVID-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_uri": {
      "type": "string",
      "format": "uri"
    },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_type",
        "revision_id"
      ],
      "properties": {
        "revision_type": {
          "enum": [
            "git_commit",
            "tag",
            "release",
            "artifact_digest",
            "url_snapshot",
            "unknown"
          ]
        },
        "revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "content_digest": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "scope"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_availability": {
      "enum": [
        "PRESENT",
        "MISSING",
        "INACCESSIBLE",
        "STALE",
        "CONFLICTED"
      ]
    },
    "verification_result": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "NOT_RUN"
      ]
    },
    "verification_method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "command_or_procedure": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scope_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "coverage_status"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage_status": {
          "enum": [
            "NOT_ASSESSED",
            "PARTIAL",
            "EXHAUSTED_WITHIN_SCOPE",
            "COMPLETE_FOR_REQUIREMENT"
          ]
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "normative_effect": {
      "const": "NONE"
    },
    "verification_artifact_uri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
